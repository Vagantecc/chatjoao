# Anthropic (obrigatório para o João conversar)
ANTHROPIC_API_KEY=
# Opcional: troca o modelo sem mexer no código
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase (sem estas variáveis o app roda em modo memória, com os dados do seed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Opcional, recomendado em produção: valida a assinatura X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# Painel /admin
ADMIN_PASSWORD=
# Opcional: segredo dos links de boleto (se vazio, usa ADMIN_PASSWORD)
BOLETO_SECRET=

# Opcional: URL pública do app (usada nos links do boleto). Na Vercel é detectada sozinha.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opcional: número oficial mostrado no QR code da landing (só dígitos, com DDI)
NEXT_PUBLIC_WHATSAPP_NUMBER=5551998111390
